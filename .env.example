# Copy this file to .env and fill in your values. Never commit .env.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_GUILD_ID=1459691779971354731
DISCORD_INVITE_URL=https://discord.gg/xJfXk8kX5
# Comma-separated Discord user IDs allowed into the admin panel. Add your own ID.
DISCORD_ADMIN_IDS=put-your-discord-user-id-here
# Optional: Discord widget needs to be enabled in Server Settings > Widget.
DISCORD_WIDGET_ENABLED=true
# Optional bot REST integration: bot must be in the server and allowed to view guild metadata.
DISCORD_BOT_TOKEN=
# Optional Discord webhook URL for new ticket and event notifications (keep secret).
DISCORD_WEBHOOK_URL=
